body {
    font-family: Arial, sans-serif;
    background-color: #f0f8ff;
    padding: 20px;
    text-align: center;
}

.container {
    max-width: 400px;
    margin: auto;
    background: white;
    padding: 20px;
    border-radius: 8px;
    box-shadow: 0 0 10px #aaa;
}

label {
    display: block;
    margin-top: 15px;
    text-align: left;
}

input {
    width: 100%;
    padding: 8px;
    margin-top: 5px;
    box-sizing: border-box;
}

button {
    margin-top: 20px;
    padding: 10px 20px;
    cursor: pointer;
}

.language-switch button {
    margin: 10px 5px 0 5px;
}
